# Docker image name (used in build.sh and run.sh)
# - Default: Docker Hub pre-built image
# - For local build: change to "hand-eye-calibration-humble" and run ./build.sh
IMAGE_NAME="hhanoo/project:hand-eye-calibration-humble"

# Docker container name (used in run.sh)
CONTAINER_NAME="hand-eye-calibration-humble"

# ROS 2 domain ID for network isolation (used in run.sh)
ROS_DOMAIN_ID=98